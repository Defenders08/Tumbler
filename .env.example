# Скопируйте в .env и при необходимости отредактируйте. Все переменные необязательны в разработке.

# Окружение: development | production (в production обязателен SESSION_SECRET)
NODE_ENV=development

# Порт HTTP-сервера
PORT=3000

# Каталог данных: база SQLite, загруженные файлы, dev-секрет сессии
DATA_DIR=./data

# Путь к базе SQLite (по умолчанию $DATA_DIR/tumbler.db)
# DB_PATH=./data/tumbler.db

# Каталог медиафайлов (по умолчанию $DATA_DIR/uploads)
# UPLOAD_DIR=./data/uploads

# Секрет сессий и CSRF — обязательный в production (сгенерируйте: openssl rand -base64 48)
# SESSION_SECRET=

# Первая учётная запись администратора: создаётся при старте, если админа ещё нет.
# Оставьте пустыми, чтобы не создавать.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Язык интерфейса по умолчанию: ru | en
DEFAULT_LOCALE=ru
