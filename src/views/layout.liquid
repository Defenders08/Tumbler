<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | default: 'tumbler' }} — tumbler</title>
  <link rel="stylesheet" href="/static/css/tumbler.css">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  {% if csrfToken %}<meta name="csrf-token" content="{{ csrfToken }}">{% endif %}
  {% if theme and theme.accentColor %}
  <style>.blog-identity { --blog-accent: {{ theme.accentColor }}; }</style>
  {% endif %}</head>
{% assign showBlogBg = false %}
{% if pageClass == 'blog' and theme.backgroundKey %}{% assign showBlogBg = true %}{% endif %}
{% assign showBlogTint = false %}
{% if theme.tintShift != null %}{% assign showBlogTint = true %}{% endif %}
<body class="{{ pageClass | default: 'dash' }}-page{% if showBlogTint %} has-blog-tint{% endif %}{% if showBlogBg %} has-blog-bg{% endif %}"{% if showBlogBg or showBlogTint %} style="{% if showBlogBg %}--blog-bg: url(/media/{{ theme.backgroundKey }});{% endif %}{% if showBlogTint %}--tint-shift: {{ theme.tintShift }};{% endif %}"{% endif %}{% if theme.backgroundHue != null %} data-bg-hue="{{ theme.backgroundHue }}"{% endif %}>
  {% include 'partials/icons' %}
  {% include 'partials/header' %}

  <div class="app-shell">
    <main class="page-main app-main">{% block content %}{% endblock %}</main>
    {% if user and pageClass != 'auth' and pageClass != 'admin' %}
    <aside class="app-sidebar">
      {% include 'partials/side_rail' %}
    </aside>
    {% endif %}
  </div>

  {% if user and pageClass != 'auth' %}
  <nav class="bottom-nav" aria-label="{{ 'nav.dashboard' | t: locale }}">
    <a href="/dashboard" class="bottom-nav-item {% if currentPath == '/dashboard' %}is-active{% endif %}">
      <svg class="icon"><use href="#i-home"/></svg><span>{{ 'nav.dashboard' | t: locale }}</span>
    </a>
    <a href="/search" class="bottom-nav-item {% if currentPath == '/search' %}is-active{% endif %}">
      <svg class="icon"><use href="#i-search"/></svg><span>{{ 'search.title' | t: locale }}</span>
    </a>
    <a href="/drafts" class="bottom-nav-item {% if currentPath == '/drafts' %}is-active{% endif %}">
      <svg class="icon"><use href="#i-pencil"/></svg><span>{{ 'nav.drafts' | t: locale }}</span>
    </a>
    <a href="/{{ user.blogSlug }}" class="bottom-nav-item">
      <svg class="icon"><use href="#i-user"/></svg><span>{{ 'nav.my_blog' | t: locale }}</span>
    </a>
    <a href="/settings/blog" class="bottom-nav-item {% if currentPath == '/settings/blog' %}is-active{% endif %}">
      <svg class="icon"><use href="#i-gear"/></svg><span>{{ 'nav.settings' | t: locale }}</span>
    </a>
  </nav>
  {% endif %}

  <div hidden class="js-dz-strings"
       data-title-one="{{ 'composer.drop_title_one' | t: locale }}"
       data-title-many="{{ 'composer.drop_title_many' | t: locale }}"
       data-sub="{{ 'composer.drop_sub' | t: locale }}"
       data-over="{{ 'composer.drop_over' | t: locale }}"
       data-replace-one="{{ 'composer.drop_replace_one' | t: locale }}"
       data-add-many="{{ 'composer.drop_add_many' | t: locale }}"
       data-remove="{{ 'composer.drop_remove' | t: locale }}"
       data-bad-type="{{ 'composer.drop_bad_type' | t: locale }}"
       data-limit="{{ 'composer.drop_limit' | t: locale }}"></div>

  <script src="/static/vendor/turndown.js"></script>
  <script src="/static/js/tumbler.js" defer></script>
  <script src="/static/js/wysiwyg.js" defer></script>
</body>
</html>
