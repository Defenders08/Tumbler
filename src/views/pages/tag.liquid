{% layout 'layout' %}
{% block content %}
<div class="feed">
    <div class="page-heading">
      <h1>#{{ tag }}</h1>
      <span class="page-sub">{{ total }}</span>
    </div>

    {% if user %}
    {% if followingTag %}{% assign tagBtn = 'social.following' %}{% assign tagCls = 'btn-secondary' %}{% else %}{% assign tagBtn = 'social.follow' %}{% assign tagCls = 'btn-success' %}{% endif %}
    <form method="post" action="/tag/{{ tag }}/follow" class="tag-follow-form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn btn-sm {{ tagCls }}">{{ tagBtn | t: locale }}</button>
    </form>
    {% endif %}

    {% if posts.size == 0 %}
    {% assign emptyText = 'search.nothing' | t: locale %}
    {% include 'partials/empty', text: emptyText %}
    {% endif %}

    {% for p in posts %}
    {% include 'partials/post_card', post: p, tz: user.timezone, back: 'dashboard' %}
    {% endfor %}

    {% assign tagPath = '/tag/' | append: tag %}
    {% include 'partials/pagination', page: page, pages: pages, basePath: tagPath %}
</div>
{% endblock %}