{% layout 'layout' %}
{% block content %}
<div class="auth-wrap">
  <section class="card auth-card">
    <h1>{{ 'auth.login.title' | t: locale }}</h1>
    {% if error %}<div class="flash-banner flash-error" role="alert">{{ error }}</div>{% endif %}
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field">
        <label for="email">{{ 'auth.login.email' | t: locale }}</label>
        <input type="email" id="email" name="email" value="{{ values.email }}" required autocomplete="email">
      </div>
      <div class="field">
        <label for="password">{{ 'auth.login.password' | t: locale }}</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary btn-block">{{ 'auth.login.submit' | t: locale }}</button>
    </form>
    <p class="auth-alt"><a href="/register">{{ 'auth.login.to_register' | t: locale }}</a></p>
  </section>
</div>
{% endblock %}
