{% layout 'layout' %}
{% block content %}
{% if themePreview %}
<div class="flash-banner flash-info">{{ 'blog.settings_title' | t: locale }} — {{ 'composer.preview' | t: locale }}. <a href="/settings/blog">{{ 'blog.back_to_blog' | t: locale }} → {{ 'nav.settings' | t: locale }}</a></div>
{% endif %}
<div class="feed">
  {% if themePreview %}
  <div class="flash-banner flash-info">{{ 'blog.settings_title' | t: locale }} — {{ 'composer.preview' | t: locale }}. <a href="/settings/blog">{{ 'blog.back_to_blog' | t: locale }} → {{ 'nav.settings' | t: locale }}</a></div>
  {% endif %}
  {% if commentError %}<div class="flash-banner flash-error" role="alert">{{ commentError }}</div>{% endif %}

  <section class="card blog-identity"{% if theme.accentColor %} style="--blog-accent: {{ theme.accentColor }}"{% endif %}>
    <div class="blog-identity-main">
      <span class="blog-avatar">
        {% if blog.avatar_key %}
        <img src="/media/{{ blog.avatar_key }}" alt="">
        {% else %}
        <span class="avatar-letter">{{ blog.slug | slice: 0, 1 }}</span>
        {% endif %}
      </span>
      <div class="blog-identity-info">
        <h1 class="blog-title">{{ blog.title }}</h1>
        <p class="blog-username">@{{ blog.slug }}</p>
        {% if theme.socials.size > 0 %}
        <div class="blog-socials">
          {% for s in theme.socials %}
          <a class="social-pill" data-net="{{ s.network }}" href="{{ s.url }}" target="_blank" rel="noopener noreferrer nofollow">
            <svg class="icon" aria-hidden="true"><use href="#i-{{ s.network }}"/></svg><span>{% if s.label %}{{ s.label }}{% else %}{{ s.network }}{% endif %}</span>
          </a>
          {% endfor %}
        </div>
        {% endif %}
        {% if blog.description %}<p class="blog-description">{{ blog.description }}</p>{% endif %}
      </div>
    </div>
  </section>

  <section class="card blog-stats">
    <div class="blog-stats-numbers">
      <div class="blog-stat">
        <span class="blog-stat-value js-followers-count">{{ followers }}</span>
        <span class="blog-stat-label">{{ 'social.followers_label' | t: locale }}</span>
      </div>
      <div class="blog-stat">
        <span class="blog-stat-value">{{ following }}</span>
        <span class="blog-stat-label">{{ 'social.subscriptions' | t: locale }}</span>
      </div>
    </div>
    <div class="blog-stats-actions">
      {% if user %}
        {% if isOwner == false %}
          {% if isFollowing %}{% assign followLabel = 'social.following' %}{% else %}{% assign followLabel = 'social.follow' %}{% endif %}
          <button type="button" class="btn btn-sm js-follow {% if isFollowing %}btn-secondary{% else %}btn-success{% endif %}"
                  data-slug="{{ blog.slug }}"
                  data-label-follow="{{ 'social.follow' | t: locale }}"
                  data-label-following="{{ 'social.following' | t: locale }}">{{ followLabel | t: locale }}</button>
        {% endif %}
      {% else %}
        <a class="btn btn-success btn-sm" href="/login?back=/{{ blog.slug }}">{{ 'social.follow' | t: locale }}</a>
      {% endif %}
      {% if blog.ask_enabled %}
      <a class="btn btn-primary btn-sm" href="/{{ blog.slug }}/ask">{{ 'ask.title' | t: locale }}</a>
      {% endif %}
    </div>
  </section>

  {% if posts.size == 0 %}
    {% assign emptyText = 'blog.empty' | t: locale %}
    {% include 'partials/empty', text: emptyText %}
    {% endif %}

  {% for p in posts %}
  {% include 'partials/post_card', post: p, tz: 'UTC', back: 'blog' %}
  {% endfor %}

  {% assign blogBase = '/' | append: blog.slug %}
  {% include 'partials/pagination', page: page, pages: pages, basePath: blogBase %}
</div>
{% endblock %}
