{% layout 'layout' %}
{% block content %}
<div class="narrow-page">
  <div class="page-heading">
    <h1>{{ 'post.edit' | t: locale }}</h1>
  </div>

  <section class="card form-card">
    <form method="post" action="/posts/{{ post.id }}/edit" enctype="multipart/form-data">
      <input type="hidden" name="type" value="{{ post.type }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% case post.type %}
      {% when 'text' %}
      {% include 'partials/fields/text', prefix: 'e-', values: values, mode: 'edit' %}
      {% when 'photo' %}
      {% include 'partials/fields/photo', prefix: 'e-', values: values, mode: 'edit' %}
      {% when 'quote' %}
      {% include 'partials/fields/quote', prefix: 'e-', values: values, mode: 'edit' %}
      {% when 'link' %}
      {% include 'partials/fields/link', prefix: 'e-', values: values, mode: 'edit' %}
      {% when 'audio' %}
      {% include 'partials/fields/audio', prefix: 'e-', values: values, mode: 'edit' %}
      {% when 'video' %}
      {% include 'partials/fields/video', prefix: 'e-', values: values, mode: 'edit' %}
      {% when 'gif' %}
      {% include 'partials/fields/gif', prefix: 'e-', values: values, mode: 'edit' %}
      {% endcase %}
      {% include 'partials/fields/common', prefix: 'e-', values: values %}
      <div class="form-actions">
        {% if post.status == 'draft' %}
        <button type="submit" name="action" value="publish" class="btn btn-primary btn-publish">{{ 'composer.publish' | t: locale }}</button>
        <button type="submit" name="action" value="save" class="btn btn-secondary">{{ 'post.save' | t: locale }}</button>
        {% else %}
        <button type="submit" name="action" value="save" class="btn btn-primary">{{ 'post.save' | t: locale }}</button>
        {% endif %}
      </div>
    </form>
  </section>
</div>
{% endblock %}
