{% layout 'layout' %}
{% block content %}
<div class="feed">
  <section class="card blog-identity blog-identity-compact">
    <span class="blog-avatar blog-avatar-sm">
      {% if blog.avatar_key %}
      <img src="/media/{{ blog.avatar_key }}" alt="">
      {% else %}
      <span class="avatar-letter">{{ blog.slug | slice: 0, 1 }}</span>
      {% endif %}
    </span>
    <h1 class="blog-title"><a href="/{{ blog.slug }}">{{ blog.title }}</a></h1>
  </section>

  {% if commentError %}<div class="flash-banner flash-error" role="alert">{{ commentError }}</div>{% endif %}

  <p class="permalink-note"><a href="/{{ blog.slug }}">← {{ 'blog.back_to_blog' | t: locale }}</a></p>

  {% include 'partials/post_card', post: post, tz: 'UTC', back: 'blog' %}
</div>
{% endblock %}
