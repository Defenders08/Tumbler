<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
{% comment %} Собственные SVG-иконки Tumbler. Стиль — плоская пиктография в духе 2012.
     Никакие ассеты Tumblr не копируются. {% endcomment %}

  <symbol id="i-text" viewBox="0 0 24 24">
    <text x="4" y="18" font-family="Helvetica, Arial, sans-serif" font-size="16" font-weight="bold" fill="currentColor">Aa</text>
  </symbol>

  <symbol id="i-photo" viewBox="0 0 24 24">
    <rect x="3" y="6" width="18" height="14" rx="2" fill="currentColor"/>
    <rect x="9" y="3" width="6" height="4" rx="1" fill="currentColor"/>
    <circle cx="12" cy="13" r="4" fill="#fff"/>
    <circle cx="12" cy="13" r="2.4" fill="currentColor"/>
  </symbol>

  <symbol id="i-quote" viewBox="0 0 24 24">
    <path d="M4 14a4 4 0 1 1 4-4v1c0 3.5-2 5.5-4 6.5l-1-1.5c1.2-.7 2-1.6 2.4-3H4z" fill="currentColor" transform="translate(3 -1)"/>
    <path d="M4 14a4 4 0 1 1 4-4v1c0 3.5-2 5.5-4 6.5l-1-1.5c1.2-.7 2-1.6 2.4-3H4z" fill="currentColor" transform="translate(13 -1)"/>
  </symbol>

  <symbol id="i-link" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="11" fill="currentColor"/>
    <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
      <path d="M9.5 14.5l5-5"/>
      <path d="M8 12l-2 2a2.8 2.8 0 0 0 4 4l2-2"/>
      <path d="M16 12l2-2a2.8 2.8 0 0 0-4-4l-2 2"/>
    </g>
  </symbol>

  <symbol id="i-audio" viewBox="0 0 24 24">
    <path d="M4 13a8 8 0 0 1 16 0" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <rect x="3" y="12" width="4.4" height="8" rx="2" fill="currentColor"/>
    <rect x="16.6" y="12" width="4.4" height="8" rx="2" fill="currentColor"/>
  </symbol>

  <symbol id="i-video" viewBox="0 0 24 24">
    <circle cx="7" cy="5.5" r="3.2" fill="none" stroke="currentColor" stroke-width="2"/>
    <circle cx="16" cy="5.5" r="3.2" fill="none" stroke="currentColor" stroke-width="2"/>
    <rect x="3" y="10" width="18" height="10" rx="2" fill="currentColor"/>
    <rect x="16.5" y="12.5" width="5" height="5" rx="1" fill="currentColor" transform="translate(-1.5 0)"/>
  </symbol>

  <symbol id="i-gif" viewBox="0 0 24 24">
    <rect x="2" y="5" width="20" height="14" rx="3" fill="currentColor"/>
    <text x="12" y="16" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="bold" fill="#fff">GIF</text>
  </symbol>

  <symbol id="i-home" viewBox="0 0 24 24">
    <path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z" fill="currentColor"/>
  </symbol>

  <symbol id="i-mail" viewBox="0 0 24 24">
    <rect x="2" y="5" width="20" height="14" rx="2" fill="currentColor"/>
    <path d="M3 7l9 6 9-6" fill="none" stroke="#fff" stroke-width="2"/>
  </symbol>

  <symbol id="i-gear" viewBox="0 0 24 24">
    <path d="M12 8.5A3.5 3.5 0 1 0 12 15.5 3.5 3.5 0 0 0 12 8.5zm9 4.9v-2.8l-2.6-.5a6.7 6.7 0 0 0-.7-1.7l1.5-2.2-2-2-2.2 1.5a6.7 6.7 0 0 0-1.7-.7L12.8 2.5h-2.8l-.5 2.6a6.7 6.7 0 0 0-1.7.7L5.6 4.3l-2 2 1.5 2.2a6.7 6.7 0 0 0-.7 1.7l-2.6.5v2.8l2.6.5c.2.6.4 1.2.7 1.7l-1.5 2.2 2 2 2.2-1.5c.5.3 1.1.5 1.7.7l.5 2.6h2.8l.5-2.6a6.7 6.7 0 0 0 1.7-.7l2.2 1.5 2-2-1.5-2.2c.3-.5.5-1.1.7-1.7z" fill="currentColor"/>
    <circle cx="12" cy="12" r="3" fill="#fff"/>
  </symbol>

  <symbol id="i-search" viewBox="0 0 24 24">
    <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/>
  </symbol>

  <symbol id="i-heart" viewBox="0 0 24 24">
    <path d="M12 20.5C7 16.5 3.5 13.2 3.5 9.5A4.7 4.7 0 0 1 8.2 4.8c1.6 0 3 .8 3.8 2a4.6 4.6 0 0 1 3.8-2 4.7 4.7 0 0 1 4.7 4.7c0 3.7-3.5 7-8.5 11z" fill="none" stroke="currentColor" stroke-width="2"/>
  </symbol>

  <symbol id="i-heart-fill" viewBox="0 0 24 24">
    <path d="M12 20.5C7 16.5 3.5 13.2 3.5 9.5A4.7 4.7 0 0 1 8.2 4.8c1.6 0 3 .8 3.8 2a4.6 4.6 0 0 1 3.8-2 4.7 4.7 0 0 1 4.7 4.7c0 3.7-3.5 7-8.5 11z" fill="currentColor"/>
  </symbol>

  <symbol id="i-reblog" viewBox="0 0 24 24">
    <path d="M7 7h9V4.5L20.5 8 16 11.5V9H9v4H7z" fill="currentColor"/>
    <path d="M17 17H8v2.5L3.5 16 8 12.5V15h9v-4h2z" fill="currentColor"/>
  </symbol>

  <symbol id="i-comment" viewBox="0 0 24 24">
    <path d="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-7l-4 4v-4H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" fill="currentColor"/>
  </symbol>

  <symbol id="i-dogear" viewBox="0 0 24 24">
    <path d="M6 3h9l5 5v13H6z" fill="none" stroke="currentColor" stroke-width="2"/>
    <path d="M15 3v5h5" fill="none" stroke="currentColor" stroke-width="2"/>
  </symbol>

  <symbol id="i-pencil" viewBox="0 0 24 24">
    <path d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19z" fill="currentColor"/>
    <path d="M4 20l4-1" stroke="#fff" stroke-width="1.4"/>
  </symbol>

  <symbol id="i-list" viewBox="0 0 24 24">
    <rect x="4" y="5" width="16" height="2.6" rx="1" fill="currentColor"/>
    <rect x="4" y="10.5" width="16" height="2.6" rx="1" fill="currentColor"/>
    <rect x="4" y="16" width="10" height="2.6" rx="1" fill="currentColor"/>
  </symbol>

  <symbol id="i-user" viewBox="0 0 24 24">
    <circle cx="12" cy="8.5" r="4" fill="currentColor"/>
    <path d="M4 20a8 8 0 0 1 16 0z" fill="currentColor"/>
  </symbol>

  <symbol id="i-warn" viewBox="0 0 24 24">
    <path d="M12 3l10 18H2z" fill="currentColor"/>
    <rect x="11" y="9" width="2" height="6" rx="1" fill="#fff"/>
    <circle cx="12" cy="17.6" r="1.3" fill="#fff"/>
  </symbol>

  <symbol id="i-pin" viewBox="0 0 24 24">
    <path d="M9 3h6l-1 6 4 4v2h-5v6l-1 1-1-1v-6H6v-2l4-4z" fill="currentColor"/>
  </symbol>

  <symbol id="i-eye" viewBox="0 0 24 24">
    <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="2"/>
    <circle cx="12" cy="12" r="2.6" fill="currentColor"/>
  </symbol>

  <symbol id="i-image" viewBox="0 0 24 24">
    <rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
    <circle cx="9" cy="10" r="2" fill="currentColor"/>
    <path d="M5 19l5-5 3 3 4-4 3 3v2z" fill="currentColor"/>
  </symbol>
</svg>
