{% comment %} Поля фото-поста. Только статичные изображения; GIF — отдельный тип.
     Раскладка: медиа-плитка слева, подпись справа (как в макете). {% endcomment %}
{% if mode == 'new' %}
<div class="composer-split">
  <div class="field field-media">
    <label for="{{ prefix }}media">{{ 'composer.media' | t: locale }}</label>
    <input type="file" id="{{ prefix }}media" name="media" accept="image/jpeg,image/png,image/webp" data-max="10" data-drop-layout="tiles" multiple required
           data-drop-title="JPEG, PNG, WebP"
           data-drop-sub="{{ 'composer.media_limit' | t: locale }}"
           data-drop-add="{{ 'composer.media_add' | t: locale }}">
  </div>
  <div class="field field-caption">
    <label for="{{ prefix }}body">{{ 'composer.caption' | t: locale }}</label>
    <textarea id="{{ prefix }}body" name="body" rows="4">{{ values.body }}</textarea>
  </div>
</div>
{% else %}
<p class="hint">{{ 'composer.file_note' | t: locale }}</p>
<div class="field">
  <label for="{{ prefix }}body">{{ 'composer.caption' | t: locale }}</label>
  <textarea id="{{ prefix }}body" name="body" rows="4">{{ values.body }}</textarea>
  <p class="hint">Markdown</p>
</div>
{% endif %}
