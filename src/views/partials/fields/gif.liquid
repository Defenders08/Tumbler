{% comment %} Поля GIF-поста: только анимированный GIF (проверяется по содержимому). {% endcomment %}
{% if mode == 'new' %}
<div class="field">
  <label for="{{ prefix }}file">{{ 'composer.file_gif' | t: locale }}</label>
  <input type="file" id="{{ prefix }}file" name="file" accept="image/gif" required>
</div>
{% else %}
<p class="hint">{{ 'composer.file_note' | t: locale }}</p>
{% endif %}
<div class="field">
  <label for="{{ prefix }}body">{{ 'composer.caption' | t: locale }}</label>
  <textarea id="{{ prefix }}body" name="body" rows="3">{{ values.body }}</textarea>
  <p class="hint">Markdown</p>
</div>
