{% comment %} Поля текстового поста. Параметры: prefix, values, mode. {% endcomment %}
<div class="field">
  <label for="{{ prefix }}title">{{ 'composer.title' | t: locale }}</label>
  <input type="text" id="{{ prefix }}title" name="title" maxlength="200" value="{{ values.title }}">
</div>
<div class="field">
  <label for="{{ prefix }}body">{{ 'composer.body' | t: locale }}</label>
  <div class="wysiwyg-wrap">
    <textarea class="js-wysiwyg" name="body" rows="8" required data-html="{{ values.body_html }}"></textarea>
  </div>
</div>
