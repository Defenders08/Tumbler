{% comment %} Верхняя панель дашборда: градиент 2012, логотип, табы, действия. {% endcomment %}
<header class="top-bar">
  <div class="top-bar-inner">
    <a class="logo" href="/dashboard" aria-label="tumbler">
      <span class="logo-t">t</span><span class="logo-word">tumbler.</span>
    </a>

    <nav class="top-tabs">
      <a href="/dashboard" class="top-tab {% if currentPath == '/dashboard' %}is-active{% endif %}">{{ 'nav.dashboard' | t: locale }}</a>
      {% if user %}
      {% assign blogPath = '/' | append: user.blogSlug %}
      <a href="{{ blogPath }}" class="top-tab {% if currentPath == blogPath %}is-active{% endif %}">{{ 'nav.my_blog' | t: locale }}</a>
      {% endif %}
    </nav>

    <form class="top-search" method="get" action="/search" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24"><use href="#i-search"/></svg>
      <input type="search" name="q" value="" maxlength="100" placeholder="{{ 'search.placeholder' | t: locale }}" autocomplete="off">
    </form>

    <div class="top-actions">
      {% if user %}
      {% if pageClass == 'blog' and blog and isOwner == false %}
      <a class="top-icon" href="/report/blog/{{ blog.id }}?back=/{{ blog.slug }}" title="{{ 'report.title' | t: locale }}">
        <svg class="icon"><use href="#i-warn"/></svg>
      </a>
      {% endif %}
      {% if unreadNotifications > 0 %}
      <a class="top-icon has-badge" href="/notifications" title="{{ 'notify.title' | t: locale }}">
        <svg class="icon"><use href="#i-mail"/></svg><span class="badge">{{ unreadNotifications }}</span>
      </a>
      {% endif %}
      <a class="top-icon {% if currentPath == '/drafts' %}is-active{% endif %}" href="/drafts" title="{{ 'nav.drafts' | t: locale }}">
        <svg class="icon"><use href="#i-pencil"/></svg>
      </a>
      <a class="top-icon {% if currentPath == '/settings/blog' %}is-active{% endif %}" href="/settings/blog" title="{{ 'nav.settings' | t: locale }}">
        <svg class="icon"><use href="#i-gear"/></svg>
      </a>
      <a class="top-avatar" href="/{{ user.blogSlug }}" title="{{ 'nav.my_blog' | t: locale }}">
        {% if user.avatarKey %}
        <img src="/media/{{ user.avatarKey }}" alt="">
        {% else %}
        <span class="avatar-letter">{{ user.blogSlug | slice: 0 }}</span>
        {% endif %}
      </a>
      <form method="post" action="/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn btn-ghost btn-sm">{{ 'nav.logout' | t: locale }}</button>
      </form>
      {% else %}
      <a class="btn btn-secondary btn-sm" href="/login">{{ 'nav.login' | t: locale }}</a>
      <a class="btn btn-primary btn-sm" href="/register">{{ 'nav.register' | t: locale }}</a>
      {% endif %}
    </div>
  </div>
</header>
