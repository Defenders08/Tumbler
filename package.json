{
  "name": "tumbler",
  "version": "0.1.0",
  "private": true,
  "description": "Блоговая социальная сеть в эстетике Tumblr 2012",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "NODE_ENV=test node --test tests/*.test.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "liquidjs": "^10.30.1",
    "markdown-it": "^15.0.3",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  }
}
